{
  "repo": "vietairs/open-codex-computer-use",
  "legs": [
    {
      "check": "repo-checks",
      "os": "linux",
      "script": "scripts/ci/repo-checks.sh",
      "image": "node:24-bookworm",
      "setup": "curl -fsSL \"https://go.dev/dl/$(curl -fsSL 'https://go.dev/dl/?mode=json' | node -e 'let s=\"\";process.stdin.on(\"data\",d=>s+=d).on(\"end\",()=>console.log(JSON.parse(s).find(r=>r.version.startsWith(\"go1.27\")).version))').linux-amd64.tar.gz\" | tar -C /usr/local -xz && export PATH=\"$PATH:/usr/local/go/bin\""
    },
    {
      "check": "swift",
      "os": "macos",
      "script": "scripts/ci/swift.sh"
    },
    {
      "check": "check-docs",
      "os": "linux",
      "script": "scripts/ci/check-docs.sh",
      "image": "node:24-bookworm"
    },
    {
      "check": "check-hygiene",
      "os": "linux",
      "script": "scripts/ci/check-hygiene.sh",
      "image": "node:24-bookworm"
    },
    {
      "check": "audit-dependencies",
      "os": "linux",
      "script": "scripts/ci/audit-dependencies.sh",
      "image": "node:24-bookworm",
      "setup": "curl -fsSL \"https://go.dev/dl/$(curl -fsSL 'https://go.dev/dl/?mode=json' | node -e 'let s=\"\";process.stdin.on(\"data\",d=>s+=d).on(\"end\",()=>console.log(JSON.parse(s).find(r=>r.version.startsWith(\"go1.27\")).version))').linux-amd64.tar.gz\" | tar -C /usr/local -xz && export PATH=\"$PATH:/usr/local/go/bin\"",
      "env": { "GOVULNCHECK_VERSION": "v1.8.0" }
    }
  ]
}
